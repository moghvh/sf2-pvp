{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node pvp/tools/build-deploy.mjs",
  "outputDirectory": "out",
  "functions": {
    "api/ws.mjs": {
      "memory": 1024,
      "maxDuration": 300,
      "includeFiles": "{pvp/data/**,extracted/web-animations/**,extracted/apk-assets/animations/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, noimageindex" }
      ]
    },
    {
      "source": "/(apk|cdn|anim|data)/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://shadowfight-liard.vercel.app" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, noimageindex" }
      ]
    },
    {
      "source": "/(families|clips)\\.json",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
